# Copy to server/.env and fill in. server/.env is gitignored — never commit real keys.

# ---- SEO ----
# The public address of the storefront, no trailing slash. Every canonical URL,
# every og:image and every structured-data id is built from it, so a wrong value
# is invisible until a search engine crawls the site and indexes the wrong host.
SITE_URL=https://sukooncrystalsolutions.com

# ---- CockroachDB (the store; leave blank to keep using data/db.json) ----
# Cockroach Cloud > Cluster > Connect > General connection string.
# URL-encode the password if it contains symbols: @ becomes %40.
DATABASE_URL=postgresql://<user>:<password>@<cluster>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# ---- MongoDB Atlas (only if you are not on CockroachDB) ----
# Ignored whenever DATABASE_URL is set, so a leftover value here is harmless.
MONGODB_URI=
MONGODB_DB=sukoon

# ---- Cloudinary ----
# Dashboard > Product Environment Credentials > "API environment variable".
# Set this and POST /api/upload stores admin uploads on the CDN instead of
# server/uploads, which does not survive a redeploy.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=sukoon
# Delivery transform applied to every image URL. f_auto = webp/avif per browser.
CLOUDINARY_TRANSFORM=f_auto,q_auto,w_1200
# Applied to review videos when they fall back to Cloudinary. A phone films in
# 4K and nobody watches a review at 4K, so the height is capped.
CLOUDINARY_VIDEO_TRANSFORM=f_auto,q_auto:good,h_1280,c_limit

# ---- Cloudflare R2 (customer review videos) ----
# Optional, and only about cost. Leave it blank and videos go to Cloudinary
# instead; the feature works either way. The reason to set it: Cloudinary meters
# bandwidth, R2 charges nothing for egress, and video is almost all egress.
#
# Cloudflare dashboard > R2 > Create bucket, then Manage API tokens > Create
# with Object Read & Write. The secret is shown once.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public URL: Settings > Public access, either the r2.dev address
# or a custom domain. Without it the server treats R2 as unconfigured, because
# an object nobody can fetch is worse than no upload at all. No trailing slash.
R2_PUBLIC_BASE=
# Key prefix inside the bucket. Objects land at <prefix>/<yyyy-mm>/<random>.mp4.
R2_PREFIX=reviews

# Largest review video accepted, in megabytes. Roughly a minute of 1080p phone
# footage at the default. The storefront checks the same number before it
# starts uploading, so keep the two in step if you change it.
REVIEW_VIDEO_MAX_MB=60

# ---- Razorpay ----
# Dashboard > Settings > API Keys. Use rzp_test_* until you have tested a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings > Webhooks: add <your-domain>/api/payments/razorpay/webhook,
# subscribe to payment.captured, and paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# ---- Shopify (for the one-time import) ----
SHOPIFY_STORE=
SHOPIFY_TOKEN=

# FreeAstroAPI - free Vedic birth charts on the storefront.
# Key from https://www.freeastroapi.com/dashboard/keys
# Server-side only: it must never appear in client code or a VITE_ variable.
# The free plan allows 80 requests a day; charts are cached per birth moment so
# each distinct birth costs two calls once and nothing thereafter.
FREE_ASTRO_API_KEY=
# Optional ceiling held below the plan limit so a burst degrades politely.
FREE_ASTRO_DAILY_BUDGET=70
