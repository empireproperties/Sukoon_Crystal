{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sukoon-crystal",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    /* React Router owns the URLs. Without this, a visitor opening
       /product/rose-quartz directly -- or refreshing on it -- gets a 404,
       because there is no such file on disk. This hands them index.html and
       lets the router read the path. */
    "not_found_handling": "single-page-application",

    /* What reaches the Worker before the asset router. Everything not listed
       here is served straight from the CDN without waking it.

       The first two are the API proxy, and without them the SPA fallback above
       would answer /api/products with index.html -- once not_found_handling is
       single-page-application every path matches an asset, so the proxy would
       never run.

       The rest are the HTML pages, which the Worker rewrites to give a crawler
       a real <title>, description and JSON-LD instead of an empty <div>. See
       client/worker.js and server/seo.js.

       Listing page paths rather than `true` is the whole trick for staying on
       the free plan: JS, CSS, fonts and product photography are the overwhelming
       majority of requests and none of them are here, so they never touch the
       Worker meter. HTML document requests -- roughly one per page a person
       actually reads -- do. */
    "run_worker_first": [
      "/api/*",
      "/uploads/*",
      "/robots.txt",
      "/sitemap.xml",
      "/",
      "/shop",
      "/shop/*",
      "/product/*",
      "/about",
      "/contact",
      "/book",
      "/calendar",
      "/birth-chart",
      "/track",
      /* Not for ranking -- these two carry `noindex`, and the Worker is the
         only thing that can say so. Left out, they would serve the shell's
         default `index, follow`. */
      "/checkout",
      "/account",
      "/privacy-policy",
      "/terms-of-service",
      "/shipping-policy",
      "/return-refund-policy",
      "/faq"
    ]
  },

  "vars": {
    /* Where the Express API lives. Kept here rather than only in the dashboard
       because `wrangler deploy` uploads this block on every deploy and it wins:
       when this was an empty string, each push blanked the dashboard value and
       the shop went empty. Change the address here, and nowhere else. No
       trailing slash. */
    "API_ORIGIN": "https://sukoon-crystal.onrender.com"
  },

  /* Without this, a deploy also deletes any dashboard variable this file does
     not mention -- so anything added there later would vanish on the next
     push the same way. */
  "keep_vars": true,

  "observability": {
    "enabled": true
  }
}
